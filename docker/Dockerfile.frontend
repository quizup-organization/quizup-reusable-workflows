# --- Build stage : exécuté sur la plateforme du runner (BUILDPLATFORM) pour éviter l'émulation. ---
FROM --platform=$BUILDPLATFORM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Configuration runtime inlinée par Vite au build.
ARG VITE_API_URL
ARG VITE_BFF_URL
ARG VITE_OIDC_AUTHORITY
ARG VITE_OIDC_CLIENT_ID=web
ARG VITE_OIDC_REDIRECT_URI
ENV VITE_API_URL=$VITE_API_URL \
    VITE_BFF_URL=$VITE_BFF_URL \
    VITE_OIDC_AUTHORITY=$VITE_OIDC_AUTHORITY \
    VITE_OIDC_CLIENT_ID=$VITE_OIDC_CLIENT_ID \
    VITE_OIDC_REDIRECT_URI=$VITE_OIDC_REDIRECT_URI

RUN npm run build

# --- Runtime stage : image cible (arm64 sur le cluster). ---
FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY <<'EOF' /etc/nginx/conf.d/default.conf
# Les probes kubelet (user-agent kube-probe/*) ne polluent pas l'access log.
map $http_user_agent $loggable {
    default        1;
    "~*kube-probe" 0;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    access_log /var/log/nginx/access.log main if=$loggable;

    # Le HTML ne doit jamais être mis en cache : après un déploiement big-bang, un
    # `index.html` obsolète épingle le client sur un ancien bundle (surface morte).
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Assets immuables : pas d'access log (volume inutile, ils saturent Loki).
    location /assets/ {
        access_log off;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
EOF

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
